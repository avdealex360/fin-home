# --- App (backend container) ---
APP_SECRET=change-me-to-random-string
DATABASE_URL=sqlite:///./data/budget.db

# --- Auth (экран логина приложения, сессия в httponly cookie) ---
# Бутстрап администратора: при первом запуске, если аккаунтов в БД ещё нет,
# из APP_USER/APP_PASSWORD_HASH создаётся админ-аккаунт со своим пространством.
# Дальше все остальные пользователи заводятся только по инвайтам из админки
# (#/admin). После создания аккаунта эти переменные на вход не влияют.
# APP_USER — логин. APP_PASSWORD_HASH — bcrypt-хэш пароля.
# Сгенерировать хэш:  make hash-password p=ваш-пароль
# (для локальной разработки можно вместо хэша задать APP_PASSWORD=plain-текстом)
APP_USER=budget
APP_PASSWORD_HASH=$2a$14$replace-with-real-hash

# --- Telegram bot / AI ---
# Публичный HTTPS-адрес приложения (для setWebhook). После перехода на домен:
APP_BASE_URL=https://coin.lunalis.tech
