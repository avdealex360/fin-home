# HTTPS по IP: свой сертификат (scripts/gen-certs.sh).
# tls internal на :443 без домена ломает TLS handshake.
{
	servers {
		protocols h1 h2
	}
}

:443 {
	tls /certs/cert.pem /certs/key.pem

	# Два пользователя, пароль хранится bcrypt-хэшем в .env (APP_PASSWORD_HASH).
	# Сгенерировать: make hash-password
	basic_auth {
		{$APP_USER} {$APP_PASSWORD_HASH}
	}

	reverse_proxy budget-app:8000
}

:80 {
	redir https://{host}{uri} permanent
}
